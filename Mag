<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Liste de pièces à récupérer</title>
<style>
  :root{
    --bg:#0f1115;
    --panel:#171a21;
    --panel2:#1d212b;
    --border:#2a2f3a;
    --text:#e8eaed;
    --muted:#8a8f9c;
    --accent:#3ea6ff;
    --accent2:#4ade80;
    --danger:#f87171;
    --warn:#fbbf24;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    background:var(--bg);
    background-image:radial-gradient(circle at top, #1a1e28 0%, var(--bg) 60%);
    color:var(--text);
    padding:16px;
    padding-bottom:40px;
  }
  h1{
    font-size:22px;
    margin:0 0 4px 0;
    display:flex;
    align-items:center;
    gap:8px;
    letter-spacing:-.2px;
  }
  .sub{
    color:var(--muted);
    font-size:13px;
    margin-bottom:18px;
  }
  .section-label{
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.08em;
    color:var(--muted);
    font-weight:700;
    margin:20px 0 8px 2px;
  }
  .section-label:first-of-type{margin-top:0;}

  form#addForm{
    display:grid;
    grid-template-columns:1fr 1fr 1.4fr 0.7fr auto;
    gap:8px;
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    box-shadow:0 2px 8px rgba(0,0,0,.15);
    padding:12px;
    margin-bottom:16px;
  }
  form#addForm input{
    background:var(--panel2);
    border:1px solid var(--border);
    border-radius:8px;
    color:var(--text);
    padding:10px;
    font-size:14px;
    width:100%;
    transition:border-color .15s;
  }
  form#addForm input:focus{
    outline:none;
    border-color:var(--accent);
  }
  form#addForm button{
    background:var(--accent2);
    border:none;
    border-radius:8px;
    color:#06210f;
    font-weight:700;
    padding:10px 14px;
    cursor:pointer;
    font-size:14px;
    transition:transform .1s;
  }
  form#addForm button:active{transform:scale(.97);}
  @media (max-width:640px){
    form#addForm{grid-template-columns:1fr 1fr;}
    form#addForm button{grid-column:1/-1;}
  }

  .toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:8px;
    font-size:13px;
    color:var(--muted);
  }
  .toolbar button{
    background:none;
    border:1px solid var(--border);
    color:var(--muted);
    border-radius:8px;
    padding:6px 10px;
    font-size:12px;
    cursor:pointer;
  }

  ul#list{
    list-style:none;
    margin:0;
    padding:0;
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  li.item{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    padding:14px;
    display:flex;
    align-items:center;
    gap:12px;
    box-shadow:0 2px 8px rgba(0,0,0,.15);
    transition:opacity .2s;
  }
  li.item.done{
    opacity:.45;
  }
  li.item.done .designation{
    text-decoration:line-through;
  }
  .check{
    width:28px;
    height:28px;
    border-radius:50%;
    border:2px solid var(--accent2);
    flex-shrink:0;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--accent2);
    font-size:16px;
  }
  li.item.done .check{
    background:var(--accent2);
    color:#06210f;
  }
  .info{flex:1;min-width:0;}
  .primary-line{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:6px;
  }
  .tag{
    font-size:22px;
    font-weight:800;
    padding:4px 10px;
    border-radius:8px;
    letter-spacing:.3px;
    line-height:1.25;
  }
  .tag.code{
    background:rgba(62,166,255,.15);
    color:var(--accent);
    border:1.5px solid rgba(62,166,255,.4);
  }
  .tag.loc{
    background:rgba(251,191,36,.15);
    color:var(--warn);
    border:1.5px solid rgba(251,191,36,.4);
  }
  .designation{
    font-size:14px;
    font-weight:500;
    color:var(--muted);
  }
  .meta{
    display:flex;
    gap:8px;
    margin-top:6px;
    flex-wrap:wrap;
  }
  .badge{
    font-size:12px;
    padding:3px 8px;
    border-radius:6px;
    background:var(--panel2);
    color:var(--muted);
    border:1px solid var(--border);
  }
  .badge.qty{color:var(--accent2);border-color:rgba(74,222,128,.3);font-weight:700;}

  @media (max-width:420px){
    .tag{font-size:19px;padding:4px 8px;}
  }

  .scan-zone{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    padding:14px;
    margin-bottom:16px;
    box-shadow:0 2px 8px rgba(0,0,0,.15);
  }
  .scan-zone.active{
    border-color:var(--accent2);
    box-shadow:0 0 0 3px rgba(74,222,128,.15);
  }
  .scan-header{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:10px;
  }
  .scan-icon{font-size:24px;}
  .scan-title{font-size:14px;font-weight:600;}
  .scan-sub{font-size:12px;color:var(--muted);}
  .scan-input{
    width:100%;
    background:var(--panel2);
    border:2px solid var(--border);
    border-radius:8px;
    color:var(--text);
    padding:12px;
    font-size:15px;
    text-align:center;
  }
  .scan-input:focus{
    outline:none;
    border-color:var(--accent2);
  }
  .scan-divider{
    display:flex;
    align-items:center;
    gap:10px;
    margin:12px 0;
    color:var(--muted);
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.05em;
  }
  .scan-divider::before, .scan-divider::after{
    content:'';
    flex:1;
    height:1px;
    background:var(--border);
  }
  #cameraBtn{
    width:100%;
    background:var(--accent);
    color:#08131c;
    border:none;
    border-radius:8px;
    padding:12px;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    transition:transform .1s;
  }
  #cameraBtn:active{transform:scale(.97);}
  #cameraBtn:disabled{opacity:.4;cursor:not-allowed;}

  .camera-overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.92);
    z-index:1000;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:16px;
  }
  .camera-overlay.open{display:flex;}
  .camera-frame{
    position:relative;
    width:100%;
    max-width:420px;
    border-radius:16px;
    overflow:hidden;
    background:#000;
    box-shadow:0 4px 24px rgba(0,0,0,.5);
  }
  #cameraVideo{
    width:100%;
    display:block;
  }
  .camera-reticle{
    position:absolute;
    top:50%;
    left:50%;
    width:65%;
    aspect-ratio:1/1;
    transform:translate(-50%,-50%);
    border:3px solid var(--accent2);
    border-radius:16px;
    box-shadow:0 0 0 2000px rgba(0,0,0,.35);
    transition:border-color .15s;
  }
  .camera-reticle.hit{
    border-color:var(--accent2);
    box-shadow:0 0 0 2000px rgba(74,222,128,.15), 0 0 24px rgba(74,222,128,.6);
  }
  .camera-status{
    color:var(--text);
    font-size:14px;
    margin-top:16px;
    text-align:center;
    min-height:20px;
  }
  .camera-close{
    margin-top:14px;
    background:var(--panel2);
    border:1px solid var(--border);
    color:var(--text);
    border-radius:10px;
    padding:10px 20px;
    font-size:14px;
    cursor:pointer;
  }
  .scan-feedback{
    margin-top:10px;
    min-height:20px;
    font-size:14px;
    text-align:center;
    font-weight:600;
  }
  .scan-feedback.ok{color:var(--accent2);}
  .scan-feedback.err{color:var(--danger);}
  .scan-log{
    margin-top:8px;
    max-height:110px;
    overflow-y:auto;
    display:flex;
    flex-direction:column;
    gap:4px;
  }
  .scan-log-item{
    font-size:12px;
    color:var(--muted);
    background:var(--panel2);
    border-radius:6px;
    padding:5px 8px;
  }
  .del{
    background:none;
    border:none;
    color:var(--muted);
    font-size:18px;
    cursor:pointer;
    padding:4px 8px;
    flex-shrink:0;
  }
  .del:hover{color:var(--danger);}
  .empty{
    text-align:center;
    color:var(--muted);
    padding:30px 10px;
    font-size:14px;
  }
  .my-qr-card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    padding:14px;
    margin-bottom:16px;
    text-align:center;
    box-shadow:0 2px 8px rgba(0,0,0,.15);
  }
  .my-qr-title{
    font-size:14px;
    font-weight:600;
    margin-bottom:10px;
  }
  .my-qr-img{
    max-width:220px;
    width:100%;
    border-radius:10px;
    border:1px solid var(--border);
  }
  .my-qr-decoded{
    margin-top:8px;
    font-size:13px;
    color:var(--muted);
  }
  .my-qr-decoded code{
    background:var(--panel2);
    padding:2px 6px;
    border-radius:6px;
    color:var(--accent);
  }
  .save-status{
    text-align:center;
    font-size:11px;
    color:var(--muted);
    margin-top:10px;
    opacity:.7;
  }
</style>
</head>
<body>

<h1>🧰 Liste de pièces à récupérer</h1>
<div class="sub">Code, emplacement, désignation — sauvegardé automatiquement sur cet appareil</div>

<div class="section-label">Identification</div>
<div class="my-qr-card">
  <div class="my-qr-title">📷 Mon QR code</div>
  <img src="data:image/png;base64," alt="QR code personnel" class="my-qr-img">
  <div class="my-qr-decoded">Contenu : <code>usr:LA</code> — version nette et scannable</div>
</div>

<div class="section-label">Ajouter manuellement</div>
<form id="addForm">
  <input type="text" id="inCode" placeholder="Code (ex: A12)" required>
  <input type="text" id="inLoc" placeholder="Emplacement (ex: B3)" required>
  <input type="text" id="inDesig" placeholder="Désignation" required>
  <input type="number" id="inQty" placeholder="Quantité" min="1" value="1" required>
  <button type="submit">Ajouter</button>
</form>

<div class="scan-zone" id="scanZone">
  <div class="scan-header">
    <span class="scan-icon">🔫</span>
    <div>
      <div class="scan-title">Sortir une pièce du stock</div>
      <div class="scan-sub">Douchette USB/Bluetooth, ou caméra du téléphone</div>
    </div>
  </div>
  <input type="text" id="scanInput" class="scan-input" placeholder="Cliquez ici puis scannez..." autocomplete="off">
  <div class="scan-divider">ou</div>
  <button id="cameraBtn">📷 Scanner avec la caméra du téléphone</button>
  <div id="scanFeedback" class="scan-feedback"></div>
  <div id="scanLog" class="scan-log"></div>
</div>

<div class="camera-overlay" id="cameraOverlay">
  <div class="camera-frame">
    <video id="cameraVideo" playsinline autoplay muted></video>
    <div class="camera-reticle" id="cameraReticle"></div>
  </div>
  <div class="camera-status" id="cameraStatus">Ouverture de la caméra...</div>
  <button class="camera-close" id="cameraClose">Fermer</button>
</div>

<div class="section-label">Pièces à récupérer</div>
<div class="toolbar">
  <span id="countInfo">0 pièce(s)</span>
  <button id="clearDone">Effacer les récupérées</button>
</div>

<ul id="list"></ul>
<div class="empty" id="emptyMsg">Aucune pièce dans la liste pour l'instant.</div>
<div class="save-status" id="saveStatus"></div>

<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
<script>
(function(){
  const STORAGE_KEY = 'liste_pieces_magasin_v1';
  let items = []; // {id, code, loc, designation, qty, done}
  let idCounter = 1;

  const listEl = document.getElementById('list');
  const emptyMsg = document.getElementById('emptyMsg');
  const countInfo = document.getElementById('countInfo');
  const saveStatus = document.getElementById('saveStatus');

  // ---- Sauvegarde locale (persiste entre les sessions sur cet appareil/navigateur) ----
  function loadFromStorage(){
    try{
      const raw = localStorage.getItem(STORAGE_KEY);
      if(!raw) return;
      const data = JSON.parse(raw);
      items = Array.isArray(data.items) ? data.items : [];
      idCounter = typeof data.idCounter === 'number' ? data.idCounter : (items.reduce((m,i)=>Math.max(m,i.id||0),0)+1);
    }catch(e){
      console.error('Erreur de chargement de la sauvegarde', e);
    }
  }

  function saveToStorage(){
    try{
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ items, idCounter }));
      saveStatus.textContent = '💾 Sauvegardé';
      clearTimeout(saveToStorage._t);
      saveToStorage._t = setTimeout(() => { saveStatus.textContent = ''; }, 1500);
    }catch(e){
      saveStatus.textContent = '⚠ Sauvegarde impossible (stockage local indisponible)';
    }
  }

  function render(){
    listEl.innerHTML = '';
    if(items.length === 0){
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
    }
    items.forEach(item => {
      const li = document.createElement('li');
      li.className = 'item' + (item.done ? ' done' : '');
      li.innerHTML = `
        <div class="check" data-id="${item.id}">${item.done ? '✓' : ''}</div>
        <div class="info">
          <div class="primary-line">
            <span class="tag code">${escapeHtml(item.code)}</span>
            <span class="tag loc">📍 ${escapeHtml(item.loc)}</span>
          </div>
          <div class="designation">${escapeHtml(item.designation)}</div>
          <div class="meta">
            <span class="badge qty">× ${escapeHtml(String(item.qty))}</span>
          </div>
        </div>
        <button class="del" data-id="${item.id}" title="Supprimer">✕</button>
      `;
      listEl.appendChild(li);
    });
    const total = items.length;
    const done = items.filter(i => i.done).length;
    countInfo.textContent = `${total} pièce(s) — ${done} récupérée(s)`;
    saveToStorage();
  }

  function escapeHtml(str){
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function addItem(designation, code, loc, qty){
    const parsedQty = parseInt(qty, 10);
    items.push({
      id: idCounter++,
      designation: designation.trim() || 'Sans nom',
      code: (code || '—').trim(),
      loc: (loc || '—').trim(),
      qty: (Number.isFinite(parsedQty) && parsedQty > 0) ? parsedQty : 1,
      done: false
    });
    render();
  }

  function toggleDoneByCode(code){
    const norm = code.trim().toLowerCase();
    const found = items.find(i => i.code.toLowerCase() === norm);
    if(found){
      found.done = true;
      render();
      return true;
    }
    return false;
  }

  // Sortie de stock via douchette : décrémente la quantité de 1, marque "récupéré" quand elle atteint 0
  function scanOut(code){
    const norm = code.trim().toLowerCase();
    if(!norm) return { status: 'empty' };
    const found = items.find(i => i.code.toLowerCase() === norm && !i.done);
    if(!found){
      const alreadyDone = items.find(i => i.code.toLowerCase() === norm && i.done);
      if(alreadyDone){
        return { status: 'already-done', item: alreadyDone };
      }
      return { status: 'not-found', code: code.trim() };
    }
    found.qty = Math.max(0, found.qty - 1);
    if(found.qty === 0){
      found.done = true;
    }
    render();
    return { status: 'ok', item: found };
  }

  function deleteByCode(code){
    const norm = code.trim().toLowerCase();
    const before = items.length;
    items = items.filter(i => i.code.toLowerCase() !== norm);
    render();
    return items.length < before;
  }

  listEl.addEventListener('click', (e) => {
    const checkEl = e.target.closest('.check');
    if(checkEl){
      const id = Number(checkEl.dataset.id);
      const item = items.find(i => i.id === id);
      if(item){ item.done = !item.done; render(); }
      return;
    }
    const delEl = e.target.closest('.del');
    if(delEl){
      const id = Number(delEl.dataset.id);
      items = items.filter(i => i.id !== id);
      render();
    }
  });

  document.getElementById('clearDone').addEventListener('click', () => {
    items = items.filter(i => !i.done);
    render();
  });

  document.getElementById('addForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const code = document.getElementById('inCode').value;
    const loc = document.getElementById('inLoc').value;
    const desig = document.getElementById('inDesig').value;
    const qty = document.getElementById('inQty').value;
    addItem(desig, code, loc, qty);
    e.target.reset();
    document.getElementById('inQty').value = 1;
    document.getElementById('inCode').focus();
  });

  // ---- Douchette (scanner code-barres / QR) ----
  // Une douchette se comporte comme un clavier : elle tape le code puis "Entrée".
  const scanZone = document.getElementById('scanZone');
  const scanInput = document.getElementById('scanInput');
  const scanFeedback = document.getElementById('scanFeedback');
  const scanLog = document.getElementById('scanLog');

  function beep(ok){
    try{
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      const ctx = new AudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.frequency.value = ok ? 880 : 220;
      gain.gain.value = 0.15;
      osc.start();
      setTimeout(() => { osc.stop(); ctx.close(); }, ok ? 90 : 180);
    }catch(e){ /* audio non disponible, on ignore */ }
  }

  function logScan(text){
    const div = document.createElement('div');
    div.className = 'scan-log-item';
    const time = new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit', second:'2-digit'});
    div.textContent = `${time} — ${text}`;
    scanLog.insertBefore(div, scanLog.firstChild);
    while(scanLog.children.length > 8){
      scanLog.removeChild(scanLog.lastChild);
    }
  }

  function processScan(rawValue){
    const value = rawValue.trim();
    if(!value) return;

    const result = scanOut(value);

    if(result.status === 'ok'){
      beep(true);
      scanFeedback.className = 'scan-feedback ok';
      scanFeedback.textContent = `✓ ${result.item.designation} — reste ${result.item.qty}${result.item.qty === 0 ? ' (récupéré)' : ''}`;
      logScan(`Sorti : ${result.item.code} (${result.item.designation}) — reste ${result.item.qty}`);
    } else if(result.status === 'already-done'){
      beep(false);
      scanFeedback.className = 'scan-feedback err';
      scanFeedback.textContent = `⚠ ${result.item.designation} déjà entièrement sortie du stock`;
      logScan(`Déjà sorti : ${result.item.code}`);
    } else if(result.status === 'not-found'){
      beep(false);
      scanFeedback.className = 'scan-feedback err';
      scanFeedback.textContent = `✕ Code inconnu : ${result.code}`;
      logScan(`Code inconnu : ${result.code}`);
    }
  }

  scanInput.addEventListener('keydown', (e) => {
    if(e.key === 'Enter'){
      e.preventDefault();
      processScan(scanInput.value);
      scanInput.value = '';
    }
  });

  scanInput.addEventListener('focus', () => scanZone.classList.add('active'));
  scanInput.addEventListener('blur', () => scanZone.classList.remove('active'));

  // Reconcentre le focus sur le champ de scan dès qu'on touche la zone,
  // pour que la douchette (qui tape comme un clavier) soit toujours captée.
  scanZone.addEventListener('click', () => scanInput.focus());

  // ---- Scan via caméra (jsQR) ----
  const cameraBtn = document.getElementById('cameraBtn');
  const cameraOverlay = document.getElementById('cameraOverlay');
  const cameraVideo = document.getElementById('cameraVideo');
  const cameraReticle = document.getElementById('cameraReticle');
  const cameraStatus = document.getElementById('cameraStatus');
  const cameraClose = document.getElementById('cameraClose');

  const isSecureForCamera = window.isSecureContext === true;
  const hasGetUserMedia = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);

  let cameraStream = null;
  let scanLoopId = null;
  let lastHitCode = null;
  let lastHitTime = 0;
  const hiddenCanvas = document.createElement('canvas');
  const hiddenCtx = hiddenCanvas.getContext('2d', { willReadFrequently: true });

  function describeCameraError(err){
    if(err && err.name === 'NotAllowedError'){
      return "Caméra refusée. Sur iPhone : Réglages > Safari > Caméra (ou Réglages > [ce site]), autorisez, puis réessayez.";
    }
    if(err && err.name === 'NotFoundError'){
      return "Aucune caméra détectée sur cet appareil.";
    }
    return "Impossible d'accéder à la caméra : " + (err && err.message ? err.message : 'erreur inconnue');
  }

  function updateCameraButtonState(){
    if(!isSecureForCamera){
      cameraBtn.disabled = true;
      cameraBtn.title = "Nécessite une connexion sécurisée (https://)";
    } else if(!hasGetUserMedia){
      cameraBtn.disabled = true;
      cameraBtn.title = "Caméra non supportée par ce navigateur";
    } else if(typeof jsQR === 'undefined'){
      cameraBtn.disabled = true;
      cameraBtn.title = "Bibliothèque de scan non chargée (vérifiez la connexion internet)";
    }
  }
  updateCameraButtonState();

  async function openCamera(){
    cameraOverlay.classList.add('open');
    cameraStatus.textContent = "Ouverture de la caméra...";
    cameraReticle.classList.remove('hit');

    if(typeof jsQR === 'undefined'){
      cameraStatus.textContent = "La bibliothèque de scan n'a pas pu être chargée. Vérifiez votre connexion internet.";
      return;
    }

    try{
      cameraStream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: { ideal: 'environment' } },
        audio: false
      });
      cameraVideo.srcObject = cameraStream;
      await cameraVideo.play();
      cameraStatus.textContent = "Visez le QR code";
      scanLoopId = requestAnimationFrame(scanFrame);
    }catch(err){
      cameraStatus.textContent = describeCameraError(err);
    }
  }

  function closeCamera(){
    cameraOverlay.classList.remove('open');
    if(scanLoopId){
      cancelAnimationFrame(scanLoopId);
      scanLoopId = null;
    }
    if(cameraStream){
      cameraStream.getTracks().forEach(t => t.stop());
      cameraStream = null;
    }
    cameraVideo.srcObject = null;
  }

  function scanFrame(){
    if(cameraVideo.readyState === cameraVideo.HAVE_ENOUGH_DATA){
      hiddenCanvas.width = cameraVideo.videoWidth;
      hiddenCanvas.height = cameraVideo.videoHeight;
      hiddenCtx.drawImage(cameraVideo, 0, 0, hiddenCanvas.width, hiddenCanvas.height);
      const imageData = hiddenCtx.getImageData(0, 0, hiddenCanvas.width, hiddenCanvas.height);
      const code = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: 'dontInvert' });

      if(code && code.data){
        const now = Date.now();
        // évite de re-scanner le même code en boucle tant qu'il reste dans le champ
        if(code.data !== lastHitCode || now - lastHitTime > 2000){
          lastHitCode = code.data;
          lastHitTime = now;
          cameraReticle.classList.add('hit');
          processScan(code.data);
          cameraStatus.textContent = `✓ Scanné : ${code.data}`;
          setTimeout(() => { cameraReticle.classList.remove('hit'); }, 500);
        }
      }
    }
    scanLoopId = requestAnimationFrame(scanFrame);
  }

  cameraBtn.addEventListener('click', openCamera);
  cameraClose.addEventListener('click', closeCamera);
  cameraOverlay.addEventListener('click', (e) => {
    if(e.target === cameraOverlay) closeCamera();
  });

  loadFromStorage();
  render();
})();
</script>

</body>
</html>
